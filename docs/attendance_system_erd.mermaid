    STUDENT {
        string roll_no PK
        string email
        vector face_vector "512-dim face embedding"
        string auth_token
    }

    SEMESTER {
        int sem_id PK
        string sem_name
    }

    SEMESTER_STUDENT {
        int sem_id FK "-> SEMESTER.sem_id"
        string roll_no FK "-> STUDENT.roll_no"
    }

    TEACHER {
        int employee_id PK
        string email
    }

    SUBJECT {
        int subject_id PK
        string subject_name
    }

    TEACHER_SUBJECT {
        int teacher_id FK "-> TEACHER.employee_id"
        int subject_id FK "-> SUBJECT.subject_id"
    }

    LIVE_CLASS {
        int live_class_id PK
        int subject_id FK "-> SUBJECT.subject_id"
        int teacher_id FK "-> TEACHER.employee_id"
        int sem_id FK "-> SEMESTER.sem_id"
        datetime created_at
    }

    ATTENDANCE {
        int attendance_id PK
        int live_class_id FK "-> LIVE_CLASS.live_class_id"
        string roll_no FK "-> STUDENT.roll_no"
        datetime created_at
    }

    STUDENT ||--o{ SEMESTER_STUDENT : "enrolled via"
    SEMESTER ||--o{ SEMESTER_STUDENT : "has"

    TEACHER ||--o{ TEACHER_SUBJECT : "assigned via"
    SUBJECT ||--o{ TEACHER_SUBJECT : "assigned via"

    SUBJECT ||--o{ LIVE_CLASS : "held for"
    TEACHER ||--o{ LIVE_CLASS : "conducts"
    SEMESTER ||--o{ LIVE_CLASS : "scheduled in"

    LIVE_CLASS ||--o{ ATTENDANCE : "generates"
    STUDENT ||--o{ ATTENDANCE : "marks"
        int teacher_id FK "-> TEACHER.employee_id"
        int subject_id FK "-> SUBJECT.subject_id"
    }

    LIVE_CLASS {
        int live_class_id PK
        int subject_id FK "-> SUBJECT.subject_id"
        int teacher_id FK "-> TEACHER.employee_id"
        int sem_id FK "-> SEMESTER.sem_id"
        datetime created_at
    }

    ATTENDANCE {
        int attendance_id PK
        int live_class_id FK "-> LIVE_CLASS.live_class_id"
        string roll_no FK "-> STUDENT.roll_no"
        datetime created_at
    }

    STUDENT ||--o{ SEMESTER_STUDENT : "enrolled via"
    SEMESTER ||--o{ SEMESTER_STUDENT : "has"

    TEACHER ||--o{ TEACHER_SUBJECT : "assigned via"
    SUBJECT ||--o{ TEACHER_SUBJECT : "assigned via"

    SUBJECT ||--o{ LIVE_CLASS : "held for"
    TEACHER ||--o{ LIVE_CLASS : "conducts"
    SEMESTER ||--o{ LIVE_CLASS : "scheduled in"

    LIVE_CLASS ||--o{ ATTENDANCE : "generates"
